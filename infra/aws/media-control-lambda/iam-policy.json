{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeMediaInstance",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "StartStopSpecificMediaInstance",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1:161150463642:instance/REPLACE_MEDIA_INSTANCE_ID"
    }
  ]
}
