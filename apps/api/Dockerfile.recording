FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir fastapi==0.115.0 'uvicorn[standard]==0.30.6' SQLAlchemy==2.0.35 psycopg2-binary==2.9.9 pydantic==2.9.2 boto3==1.42.0
COPY app/__init__.py app/db.py app/models.py app/schemas.py app/auth.py app/auth_security.py app/recording_engine.py app/recording_service.py ./app/
CMD ["uvicorn", "app.recording_service:app", "--host", "0.0.0.0", "--port", "8010"]
